  "features": [
    {
      "name": "Institutional Fund Management",
      "description": "Comprehensive institutional fund management system with XRPL integration, compliance, and multi-jurisdictional support",
      "files": [
        "convex/funds/management.ts",
        "convex/funds/institutional_management.ts",
        "convex/funds/advanced_management.ts",
        "convex/funds/xrpl_fund_management.ts",
        "src/components/InstitutionalDashboard.tsx",
        "src/components/FundDashboard.tsx",
        "src/components/CreateFundModal.tsx",
        "src/components/InstitutionalFundCreator.tsx"
      ],
      "api_doc": {
        "openapi": "3.0.0",
        "info": {
          "title": "Institutional Fund Management API",
          "version": "1.0.0",
          "description": "API for managing institutional funds with XRPL integration"
        },
        "paths": {
          "/funds": {
            "get": {
              "summary": "List all funds",
              "responses": {
                "200": {
                  "description": "List of funds",
                  "content": {
                    "application/json": {
                      "schema": {
                        "type": "array",
                        "items": {
                          "$ref": "#/components/schemas/Fund"
                        }
                      }
                    }
                  }
                }
              }
            },
            "post": {
              "summary": "Create a new fund",
              "requestBody": {
                "content": {
                  "application/json": {
                    "schema": {
                      "$ref": "#/components/schemas/CreateFundRequest"
                    }
                  }
                }
              },
              "responses": {
                "201": {
                  "description": "Fund created successfully"
                }
              }
            }
          }
        },
        "components": {
          "schemas": {
            "Fund": {
                        "type": "object",
                        "properties": {
                "id": {"type": "string"},
                "name": {"type": "string"},
                "symbol": {"type": "string"},
                "fundType": {"type": "string"},
                "status": {"type": "string"},
                "aum": {"type": "number"},
                "nav": {"type": "number"}
              }
            }
          }
        }
      }
    },
