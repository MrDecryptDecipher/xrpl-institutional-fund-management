{
  "name": "flex-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend dev:xaman",
    "dev:frontend": "vite",
    "dev:backend": "convex dev --typecheck=disable",
    "dev:xaman": "npx tsx src/xaman-payload-server.ts",
    "build": "vite build",
    "lint": "tsc -p convex -noEmit --pretty false && tsc -p . -noEmit --pretty false && convex dev --once && vite build",
    "test": "npx tsx run_all_xrpl_tests.ts",
    "test:integration": "npx tsx test_real_xrpl_integration.ts",
    "test:lending": "npx tsx test_lending_protocol_real.ts",
    "test:domains": "npx tsx test_permissioned_domains_real.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@convex-dev/auth": "^0.0.80",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@types/cors": "^2.8.19",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.3",
    "@types/ws": "^8.18.1",
    "axios": "^1.12.2",
    "buffer": "^6.0.3",
    "child_process": "^1.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.24.2",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "express": "^5.1.0",
    "jspdf": "^3.0.3",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.544.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.9.4",
    "recharts": "^3.2.1",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.3.1",
    "toml": "^3.0.0",
    "ts-node": "^10.9.2",
    "ws": "^8.18.3",
    "xrpl": "^4.4.1",
    "xumm": "^1.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.55.1",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "~10",
    "dotenv": "^16.6.1",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "npm-run-all": "^4.1.5",
    "postcss": "~8",
    "prettier": "^3.5.3",
    "tailwindcss": "~3",
    "tsx": "^4.20.5",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0"
  }
}
